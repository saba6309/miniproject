body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f2f2f2;
  height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  max-width: 360px; /* Adjust width for mobile */
  height: 100%;
  max-height: 720px; /* Adjust height for mobile */
  background-color: #fff;
  border: 1px solid #ddd;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  position: relative;
}

.chatbot-window {
  position: relative;
  width: 100%;
  height: 100%;
  background-color: #222; /* Dark chat window background */
  border-radius: 10px;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chatbot-header {
  background-color: #fff; /* White header */
  color: #000;
  padding: 10px;
  text-align: center;
  font-weight: bold;
}

.chatbot-body {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
  color: #fff;
}

.chatbot-footer {
  display: flex;
  padding: 10px;
  background-color: #333;
}

.chatbot-footer input {
  flex: 1;
  padding: 10px;
  border: none;
  border-radius: 5px;
  margin-right: 10px;
}

.chatbot-footer button {
  padding: 10px;
  background-color: #fff;
  color: #000;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.chatbot-footer button:hover {
  background-color: #f1f1f1;
}

.message {
  margin: 5px 0;
  padding: 10px;
  border-radius: 5px;
  max-width: 80%;
}

.message.user {
  background-color: #007bff;
  color: #fff;
  align-self: flex-end;
}

.message.bot {
  background-color: #555;
  color: #fff;
  align-self: flex-start;
}
.message.bot strong {
  color: #ffcc00; /* Example color for headers */
}

.message.bot p {
  margin-bottom: 10px; /* Space between paragraphs */
}
